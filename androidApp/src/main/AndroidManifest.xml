<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The default network's callback, which retries failed loads when the connection is back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup is off, so Tink-encrypted tokens are never restored onto a device without their Keystore key. -->
    <application
            android:name=".SankakuApplication"
            android:allowBackup="false"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:supportsRtl="true"
            android:theme="@style/Theme.Tessera">
        <activity
                android:exported="true"
                android:name=".MainActivity"
                android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Export queue's file, read only by the app picked in the share sheet (platformShareFile). -->
        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.exports"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/exports" />
        </provider>
    </application>

</manifest>
